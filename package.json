{
  "name": "r-code-agent",
  "version": "0.5.1",
  "private": true,
  "author": "Code Agent",
  "description": "وكيل برمجة وجهاز محلي لنظام Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:ui": "playwright test tests/ui/build.spec.ts",
    "test:coverage": "NODE_V8_COVERAGE=coverage tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "electron-vite preview",
    "package:win": "npm run check && electron-builder --win nsis --config.directories.output=release-latest",
    "run:win": "npm run build && electron-builder --win nsis --config.directories.output=release-latest && taskkill /F /IM \"Code Agent.exe\" /T >nul 2>&1 & start \"\" release-latest\\Code-Agent-0.5.0-Setup.exe"
  },
  "build": {
    "appId": "local.r-code-agent.desktop",
    "productName": "Code Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "Code-Agent-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Code Agent"
    },
    "publish": {
      "provider": "github",
      "owner": "pocoprox555-design",
      "repo": "code-agent-desktop",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@sentry/electron": "^7.16.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "gh-pages": "^6.3.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "typescript": "^5.9.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "tsx": "^4.20.0",
    "vite": "^7.0.0"
  }
}
